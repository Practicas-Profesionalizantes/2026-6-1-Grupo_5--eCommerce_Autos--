# Conexión con el backend (Backend_CarFind). Ver README.md de la carpeta CarFindWeb.
#   VITE_USE_MOCK=false → los servicios llaman al backend real.
#   VITE_USE_MOCK=true  → datos de prueba en memoria, sin backend (el login igual necesita el backend).
VITE_USE_MOCK=false
# Ruta base de la API. Vite la redirige al backend (ver vite.config.js).
VITE_API_URL=/api/web
